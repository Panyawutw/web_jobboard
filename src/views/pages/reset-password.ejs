<%- include('../partials/header', { title: title }) %>
<link rel="stylesheet" href="/css/navbar.css">
<%- include('../partials/navbar') %>

<main style="max-width: 520px; margin: 50px auto 40px; padding: 32px; background: #fff; border-radius: 12px; box-shadow: 0 4px 16px rgba(0,0,0,0.06); font-family: 'Kanit', sans-serif;">
  <div style="text-align: center; margin-bottom: 24px;">
    <h1 style="color: #0F172A; font-size: 24px; margin: 0 0 8px;">ตั้งรหัสผ่านใหม่</h1>
    <p style="color: #64748B; font-size: 14px; margin: 0;">
      กรุณากำหนดรหัสผ่านใหม่ที่มีความยาวอย่างน้อย 8 ตัวอักษร
    </p>
  </div>

  <% if (invalidToken) { %>
    <div style="background: #FEF2F2; border: 1px solid #FCA5A5; color: #991B1B; padding: 16px; border-radius: 8px; font-size: 14px; text-align: center; margin-bottom: 20px;">
      <p style="margin: 0 0 12px; font-weight: 500;">❌ ลิงก์ตั้งรหัสผ่านนี้ไม่ถูกต้องหรือหมดอายุแล้ว</p>
      <a href="/forgot-password" style="display: inline-block; background: #DC2626; color: #fff; padding: 8px 16px; border-radius: 6px; text-decoration: none; font-size: 13px;">
        ขอรับลิงก์ใหม่
      </a>
    </div>
  <% } else { %>
    <% if (errors.password || errors.confirmPassword) { %>
      <div style="background: #FEF2F2; border: 1px solid #FCA5A5; color: #991B1B; padding: 12px; border-radius: 6px; font-size: 14px; margin-bottom: 16px;">
        <%= errors.password || errors.confirmPassword %>
      </div>
    <% } %>

    <form action="/reset-password" method="post" style="display: flex; flex-direction: column; gap: 16px;">
      <input type="hidden" name="token" value="<%= token %>">

      <div>
        <label for="password" style="display: block; font-weight: 500; font-size: 14px; margin-bottom: 6px; color: #1E293B;">
          รหัสผ่านใหม่ <span style="color: #EF4444;">*</span>
        </label>
        <input
          type="password"
          id="password"
          name="password"
          placeholder="อย่างน้อย 8 ตัวอักษร"
          required
          minlength="8"
          style="width: 100%; padding: 10px 14px; border: 1px solid #CBD5E1; border-radius: 8px; font-size: 14px; box-sizing: border-box;"
        >
      </div>

      <div>
        <label for="confirmPassword" style="display: block; font-weight: 500; font-size: 14px; margin-bottom: 6px; color: #1E293B;">
          ยืนยันรหัสผ่านใหม่ <span style="color: #EF4444;">*</span>
        </label>
        <input
          type="password"
          id="confirmPassword"
          name="confirmPassword"
          placeholder="กรอกรหัสผ่านใหม่อีกครั้ง"
          required
          minlength="8"
          style="width: 100%; padding: 10px 14px; border: 1px solid #CBD5E1; border-radius: 8px; font-size: 14px; box-sizing: border-box;"
        >
      </div>

      <button type="submit" style="background: #059669; color: #fff; padding: 12px; border: none; border-radius: 8px; font-size: 15px; font-weight: 500; cursor: pointer; transition: background 0.2s;">
        บันทึกรหัสผ่านใหม่ และเข้าสู่ระบบ →
      </button>
    </form>
  <% } %>

  <div style="text-align: center; margin-top: 24px; font-size: 14px;">
    <a href="/login" style="color: #64748B; text-decoration: none;">
      ← กลับไปยังหน้าเข้าสู่ระบบ
    </a>
  </div>
</main>

<script src="/JS/navbar.js"></script>
</body>
</html>
