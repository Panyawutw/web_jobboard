<%- include('../partials/header', { title }) %>
<%- include('../partials/navbar') %>

<main class="fh-page-main">
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-12 col-sm-10 col-md-6 col-lg-5">

        <!-- ══════════════════════════════════════════════════════ -->
        <!-- การ์ดฟอร์มตั้งรหัสผ่านใหม่                           -->
        <!-- ══════════════════════════════════════════════════════ -->
        <div class="card border shadow-sm p-4">
          <div class="card-body p-0">

            <!-- หัวข้อ -->
            <div class="text-center mb-4">
              <i class="bi bi-key text-success fs-1 mb-2 d-block"></i>
              <h1 class="h4 fw-bold text-dark mb-1">ตั้งรหัสผ่านใหม่</h1>
              <p class="text-muted small mb-0">
                กรุณากำหนดรหัสผ่านใหม่ที่มีความยาวอย่างน้อย 8 ตัวอักษร
              </p>
            </div>

            <!-- กรณี Token หมดอายุหรือไม่ถูกต้อง -->
            <% if (invalidToken) { %>
              <div class="alert alert-danger text-center">
                <p class="mb-2 fw-medium">ลิงก์ตั้งรหัสผ่านนี้ไม่ถูกต้องหรือหมดอายุแล้ว</p>
                <a href="/forgot-password" class="btn btn-sm btn-danger">ขอรับลิงก์ใหม่</a>
              </div>

            <!-- กรณี Token ถูกต้อง: แสดงฟอร์ม -->
            <% } else { %>

              <!-- แสดง Error (ถ้ามี) -->
              <% if (errors.password || errors.confirmPassword) { %>
                <div class="alert alert-danger py-2 small">
                  <%= errors.password || errors.confirmPassword %>
                </div>
              <% } %>

              <!-- ฟอร์มตั้งรหัสผ่านใหม่ -->
              <form action="/reset-password" method="post" class="d-flex flex-column gap-3">

                <!-- ส่ง Token แบบซ่อน เพื่อยืนยันตัวตนกับ server -->
                <input type="hidden" name="token" value="<%= token %>">

                <!-- ช่องรหัสผ่านใหม่ -->
                <div>
                  <label for="password" class="form-label fw-medium">
                    รหัสผ่านใหม่ <span class="text-danger">*</span>
                  </label>
                  <input
                    type="password"
                    id="password"
                    name="password"
                    class="form-control"
                    placeholder="อย่างน้อย 8 ตัวอักษร"
                    required
                    minlength="8">
                </div>

                <!-- ช่องยืนยันรหัสผ่าน -->
                <div>
                  <label for="confirmPassword" class="form-label fw-medium">
                    ยืนยันรหัสผ่านใหม่ <span class="text-danger">*</span>
                  </label>
                  <input
                    type="password"
                    id="confirmPassword"
                    name="confirmPassword"
                    class="form-control"
                    placeholder="กรอกรหัสผ่านใหม่อีกครั้ง"
                    required
                    minlength="8">
                </div>

                <!-- ปุ่มบันทึก -->
                <button type="submit" class="btn btn-success w-100">
                  บันทึกรหัสผ่านใหม่
                  <i class="bi bi-arrow-right ms-1"></i>
                </button>

              </form>

            <% } %>

            <!-- ลิงก์กลับหน้า Login -->
            <div class="text-center mt-3">
              <a href="/login" class="text-muted small text-decoration-none">
                <i class="bi bi-arrow-left me-1"></i>กลับไปยังหน้าเข้าสู่ระบบ
              </a>
            </div>

          </div>
        </div><!-- /.card -->

      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
