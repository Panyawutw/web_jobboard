<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f4f2ee">
    <title>เข้าสู่ระบบ | ก้าว</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    >
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/login.css?v=8">
  </head>

  <body>
    <%- include('../partials/navbar') %>
    <main class="login-page">
      <section class="login-card" aria-labelledby="login-title">
        <h1 id="login-title">เข้าสู่ระบบ</h1>
        <p class="intro">
          ยินดีต้อนรับกลับสู่เครือข่ายมืออาชีพ<br class="desktop-break">
          เพื่อโอกาสทางอาชีพและธุรกิจของคุณ
        </p>

        <% if (errors.form) { %>
          <div class="message error" role="alert"><%= errors.form %></div>
        <% } %>

        <% if (success) { %>
          <div class="message success" role="status">
            <%= success %>
            <% if (typeof accountName !== 'undefined' && accountName) { %>
              ยินดีต้อนรับ <%= accountName %>
            <% } %>
          </div>
        <% } %>

        <% if (typeof accountRole !== 'undefined' && accountRole) { %>
          <form action="/logout" method="post">
            <button class="logout-button" type="submit">ออกจากระบบ</button>
          </form>
        <% } %>

        <!-- ส่งอีเมล/ชื่อผู้ใช้และรหัสผ่านให้ Auth Controller ตรวจสอบ -->
        <form class="login-form" action="/login" method="post">
          <div class="field-head">
            <label for="identifier">อีเมลหรือชื่อผู้ใช้</label>
            <% if (errors.identifier) { %>
              <small class="error-text"><%= errors.identifier %></small>
            <% } %>
          </div>

          <div class="input-wrap">
            <span class="input-icon" aria-hidden="true">♙</span>
            <input
              id="identifier"
              name="identifier"
              value="<%= values.identifier || '' %>"
              placeholder="เช่น name@example.com หรือ username"
              autocomplete="username"
              required
            >
          </div>

          <div class="password-head">
            <label for="password">รหัสผ่าน</label>
            <a href="/forgot-password">
              ลืมรหัสผ่าน?
            </a>
          </div>

          <div class="input-wrap">
            <svg class="input-icon-svg" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="5" y="10" width="14" height="11" rx="2" />
              <path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3" />
            </svg>
            <input
              id="password"
              name="password"
              type="password"
              placeholder="กรอกรหัสผ่านของคุณ"
              autocomplete="current-password"
              required
            >
            <button
              type="button"
              class="password-toggle"
              aria-label="แสดงรหัสผ่าน"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path class="eye-open" d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" />
                <circle class="eye-open" cx="12" cy="12" r="3" />
                <path class="eye-closed" d="m3 3 18 18M10.6 10.6a2 2 0 0 0 2.8 2.8M9.9 5.1A11 11 0 0 1 12 5c6.4 0 10 7 10 7a17 17 0 0 1-3.1 4.1M6.6 6.6C3.7 8.3 2 12 2 12s3.6 7 10 7c1 0 1.9-.2 2.7-.5" />
              </svg>
            </button>
          </div>

          <% if (errors.password) { %>
            <small class="error-text"><%= errors.password %></small>
          <% } %>

          <div class="form-options">
            <label class="remember">
              <input type="checkbox" name="remember" value="yes">
              <span>จดจำฉันไว้ในระบบ</span>
            </label>

            <span class="safe-label">
              <svg class="safe-icon" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="m8 12 2.5 2.5L16 9" />
              </svg>
              ระบบปลอดภัย
            </span>
          </div>

          <button type="submit" class="login-button">
            เข้าสู่ระบบ <span aria-hidden="true">→</span>
          </button>
        </form>

        <div class="divider"><span>หรือเข้าสู่ระบบด้วย</span></div>

        <div class="oauth-row">
          <a href="/auth/google?from=login" class="oauth-button">
            <span class="google-icon">G</span>Google
          </a>
          <a href="/auth/github?from=login" class="oauth-button">
            <%- include('../partials/github-icon') %>GitHub
          </a>
        </div>

        <div class="register-prompt">
          ยังไม่มีบัญชีผู้ใช้? <a href="/register">สมัครสมาชิกใหม่</a>
        </div>
      </section>
    </main>

    <!-- Firebase SDK สำหรับ Google และ GitHub Sign-In -->
    <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-auth-compat.js"></script>
    <script src="/JS/firebase-auth.js" defer></script>
    <script src="/JS/navbar.js" defer></script>
    <script src="/js/login.js" defer></script>
  </body>
</html>
