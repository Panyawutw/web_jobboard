<%- include('../partials/header', { title: title }) %>
<link rel="stylesheet" href="/css/navbar.css">
<%- include('../partials/navbar') %>

<main style="max-width: 520px; margin: 50px auto 40px; padding: 32px; background: #fff; border-radius: 12px; box-shadow: 0 4px 16px rgba(0,0,0,0.06); font-family: 'Kanit', sans-serif;">
  <div style="text-align: center; margin-bottom: 24px;">
    <h1 style="color: #0F172A; font-size: 24px; margin: 0 0 8px;">ลืมรหัสผ่าน?</h1>
    <p style="color: #64748B; font-size: 14px; margin: 0;">
      กรอกอีเมลบัญชีของคุณเพื่อรับลิงก์สำหรับตั้งรหัสผ่านใหม่
    </p>
  </div>

  <% if (errors.email) { %>
    <div style="background: #FEF2F2; border: 1px solid #FCA5A5; color: #991B1B; padding: 12px; border-radius: 6px; font-size: 14px; margin-bottom: 16px;">
      <%= errors.email %>
    </div>
  <% } %>

  <% if (success) { %>
    <div style="background: #ECFDF5; border: 1px solid #A7F3D0; color: #065F46; padding: 14px; border-radius: 6px; font-size: 14px; margin-bottom: 20px;">
      <%= success %>
      <% if (resetLink) { %>
        <div style="margin-top: 14px; padding-top: 12px; border-top: 1px dashed #6EE7B7;">
          <div style="font-weight: 500; margin-bottom: 6px; color: #064E3B;">🔗 ลิงก์สำหรับทดสอบตั้งรหัสผ่าน (Dev Mode):</div>
          <a href="<%= resetLink %>" style="color: #2563EB; word-break: break-all; font-size: 13px; text-decoration: underline;">
            <%= resetLink %>
          </a>
        </div>
      <% } %>
    </div>
  <% } %>

  <form action="/forgot-password" method="post" style="display: flex; flex-direction: column; gap: 16px;">
    <div>
      <label for="email" style="display: block; font-weight: 500; font-size: 14px; margin-bottom: 6px; color: #1E293B;">
        อีเมลของคุณ <span style="color: #EF4444;">*</span>
      </label>
      <input
        type="email"
        id="email"
        name="email"
        value="<%= values.email || '' %>"
        placeholder="you@example.com"
        required
        style="width: 100%; padding: 10px 14px; border: 1px solid #CBD5E1; border-radius: 8px; font-size: 14px; box-sizing: border-box;"
      >
    </div>

    <button type="submit" style="background: #2563EB; color: #fff; padding: 12px; border: none; border-radius: 8px; font-size: 15px; font-weight: 500; cursor: pointer; transition: background 0.2s;">
      ส่งลิงก์รีเซ็ตรหัสผ่าน →
    </button>
  </form>

  <div style="text-align: center; margin-top: 24px; font-size: 14px;">
    <a href="/login" style="color: #64748B; text-decoration: none;">
      ← กลับไปยังหน้าเข้าสู่ระบบ
    </a>
  </div>
</main>

<script src="/JS/navbar.js"></script>
</body>
</html>
