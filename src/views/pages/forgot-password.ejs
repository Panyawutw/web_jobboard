<%- include('../partials/header', { title }) %>
<%- include('../partials/navbar') %>

<main class="fh-page-main">
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-12 col-sm-10 col-md-6 col-lg-5">

        <!-- ══════════════════════════════════════════════════════ -->
        <!-- การ์ดฟอร์มลืมรหัสผ่าน                               -->
        <!-- ══════════════════════════════════════════════════════ -->
        <div class="card border shadow-sm p-4">
          <div class="card-body p-0">

            <!-- หัวข้อ -->
            <div class="text-center mb-4">
              <i class="bi bi-envelope-open text-primary fs-1 mb-2 d-block"></i>
              <h1 class="h4 fw-bold text-dark mb-1">ลืมรหัสผ่าน?</h1>
              <p class="text-muted small mb-0">
                กรอกอีเมลบัญชีของคุณเพื่อรับลิงก์สำหรับตั้งรหัสผ่านใหม่
              </p>
            </div>

            <!-- แสดง Error (ถ้ามี) -->
            <% if (errors.email) { %>
              <div class="alert alert-danger py-2 small">
                <%= errors.email %>
              </div>
            <% } %>

            <!-- แสดงข้อความสำเร็จ (ถ้ามี) -->
            <% if (success) { %>
              <div class="alert alert-success py-2 small">
                <%= success %>
                <!-- Dev Mode: แสดงลิงก์ทดสอบ (ปิดใน Production) -->
                <% if (resetLink) { %>
                  <hr class="my-2">
                  <div class="fw-medium mb-1">
                    <i class="bi bi-link-45deg me-1"></i>ลิงก์สำหรับทดสอบ (Dev Mode):
                  </div>
                  <a href="<%= resetLink %>" class="text-break small">
                    <%= resetLink %>
                  </a>
                <% } %>
              </div>
            <% } %>

            <!-- ฟอร์มกรอกอีเมล -->
            <form action="/forgot-password" method="post" class="d-flex flex-column gap-3">

              <!-- ช่องอีเมล -->
              <div>
                <label for="email" class="form-label fw-medium">
                  อีเมลของคุณ <span class="text-danger">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  class="form-control"
                  value="<%= values.email || '' %>"
                  placeholder="you@example.com"
                  required>
              </div>

              <!-- ปุ่มส่ง -->
              <button type="submit" class="btn btn-primary w-100">
                ส่งลิงก์รีเซ็ตรหัสผ่าน
                <i class="bi bi-arrow-right ms-1"></i>
              </button>

            </form>

            <!-- ลิงก์กลับหน้า Login -->
            <div class="text-center mt-3">
              <a href="/login" class="text-muted small text-decoration-none">
                <i class="bi bi-arrow-left me-1"></i>กลับไปยังหน้าเข้าสู่ระบบ
              </a>
            </div>

          </div>
        </div><!-- /.card -->

      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
