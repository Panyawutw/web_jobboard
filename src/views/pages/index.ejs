<%- include('../partials/header', { title: 'FreelanceHub - ค้นหาและจัดการงานฟรีแลนซ์' }) %>
<%- include('../partials/navbar') %>

<main>
    <!-- ค้นหาและกรองงาน (Search and Filter) -->
    <section id="search-section">
        <h2>ค้นหางาน</h2>

        <label for="search-input">ค้นหาชื่องานหรือหมวดหมู่</label>
        <input type="text" id="search-input" placeholder="เช่น Frontend Developer">

        <label for="categories">หมวดหมู่</label>
        <select id="categories">
            <option value="All">ทุกหมวดหมู่</option>
            <option value="Web Development">Web Development</option>
            <option value="Design">Design</option>
            <option value="Java">Java</option>
            <option value="Python">Python</option>
            <option value="Android">Android</option>
            <option value="c#">C#</option>
        </select>

        <label for="budgetfilter">งบประมาณ</label>
        <select id="budgetfilter">
            <option value="All">ทั้งหมด</option>
            <option value="under10k">ต่ำกว่า 10,000 บาท</option>
            <option value="10to20k">10,000–20,000 บาท</option>
            <option value="over20k">มากกว่า 20,000 บาท</option>
        </select>
    </section>

    <!-- ฟอร์มเพิ่มงาน / แก้ไขงาน (ดึงมาจาก Partial) -->
    <%- include('../partials/jobForm') %>

    <!-- รายการงาน (Job List) -->
    <section>
        <h2>รายการงาน</h2>
        <div id="job-list"></div>
    </section>

    <!-- รายละเอียดงาน (Job Details) -->
    <section>
        <h2>รายละเอียดงาน</h2>
        <div id="job-detail">
            <p>เลือก View Details ของงานเพื่อดูรายละเอียด</p>
        </div>
    </section>
</main>

<%- include('../partials/footer') %>
