<%- include('../partials/header', { title: 'FreelanceHub - หางาน สมัครงานออนไลน์', bootstrapCarousel: true, currentPath: '/' }) %>
<%- include('../partials/navbar', { currentPath: '/' }) %>

<%
  // ── ตัวแปรที่ใช้ทั่วหน้า ────────────────────────────────────────
  // ดึงค่าที่ส่งมาจาก controller (ถ้าไม่มีให้ใช้ค่าเริ่มต้น)
  var currentSearch   = typeof search   !== 'undefined' ? search   : '';
  var currentCategory = typeof category !== 'undefined' ? category : '';
  var jobList         = typeof jobs     !== 'undefined' ? jobs     : [];
  var isGuest         = typeof accountName === 'undefined' || !accountName;

  // helper: เช็คว่า category pill นี้ active อยู่ไหม
  function isActive(cat) {
    return currentCategory === cat ? 'active' : '';
  }
%>

<main class="fh-page-main">
  <div class="container-xl py-4">

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- ส่วนที่ 1: ช่องค้นหางาน (Search Hero)                     -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <section class="fh-search-hero mb-4">

      <!-- หัวข้อ -->
      <div class="text-center mb-4">
        <h1 class="fh-hero-title">ค้นหางานที่ใช่ ได้งานที่ชอบ</h1>
        <p class="fh-hero-subtitle">ศูนย์รวมตำแหน่งงานคุณภาพ รองรับทั้งงานประจำ · Hybrid · Remote</p>
      </div>

      <!-- ฟอร์มค้นหา: ส่ง GET ไปที่ / พร้อม query ?search=...&category=... -->
      <form id="job-search-form" class="fh-search-form" action="/" method="get">
        <div class="row g-2 align-items-center">

          <!-- ช่องพิมพ์ชื่องาน -->
          <div class="col-12 col-md-6">
            <div class="input-group fh-input-group">
              <span class="input-group-text fh-input-icon">
                <i class="bi bi-search"></i>
              </span>
              <input
                type="text"
                name="search"
                class="form-control fh-input"
                value="<%= currentSearch %>"
                placeholder="ตำแหน่งงาน, ทักษะ เช่น Developer, Designer...">
            </div>
          </div>

          <!-- เลือกหมวดหมู่ -->
          <div class="col-12 col-md-4">
            <select name="category" class="form-select fh-select">
              <option value="">ทุกหมวดหมู่งาน</option>
              <% categories.forEach(function(cat) { %>
                <% if (cat !== 'ทั้งหมด') { %>
                  <option value="<%= cat %>" <%= currentCategory === cat ? 'selected' : '' %>>
                    <%= cat %>
                  </option>
                <% } %>
              <% }); %>
            </select>
          </div>

          <!-- ปุ่มค้นหา -->
          <div class="col-12 col-md-2">
            <button type="submit" class="btn fh-btn-search w-100">ค้นหา</button>
          </div>

        </div>
      </form>

      <!-- ปุ่มหมวดหมู่ลัด (Quick Filter Pills) -->
      <div class="fh-category-pills d-flex flex-wrap gap-2 justify-content-center mt-3">
        <span class="fh-pill-label">หมวดยอดนิยม:</span>
        <a href="/"                          class="badge fh-cat-pill <%= isActive('') %>">ทั้งหมด</a>
        <a href="/?category=Web+Development" class="badge fh-cat-pill <%= isActive('Web Development') %>">Web Dev</a>
        <a href="/?category=Design"          class="badge fh-cat-pill <%= isActive('Design') %>">Design</a>
        <a href="/?category=Mobile+App"      class="badge fh-cat-pill <%= isActive('Mobile App') %>">Mobile App</a>
        <a href="/?category=Marketing"       class="badge fh-cat-pill <%= isActive('Marketing') %>">Marketing</a>
        <a href="/?category=Finance"         class="badge fh-cat-pill <%= isActive('Finance') %>">Finance</a>
      </div>

    </section>


    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- ส่วนที่ 2: แบนเนอร์โฆษณา (แสดงเฉพาะผู้ที่ยังไม่ได้ล็อกอิน) -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <% if (isGuest) { %>
    <div class="fh-banner-wrap mb-4">

      <!-- Bootstrap Carousel: เลื่อนอัตโนมัติทุก 4.5 วินาที -->
      <div id="fh-banner" class="carousel slide carousel-fade"
           data-bs-ride="carousel"
           data-bs-interval="4500"
           aria-label="แบนเนอร์ประชาสัมพันธ์">

        <!-- จุดแสดงสไลด์ปัจจุบัน (ด้านล่างแบนเนอร์) -->
        <div class="carousel-indicators">
          <button type="button" data-bs-target="#fh-banner" data-bs-slide-to="0" class="active" aria-current="true" aria-label="แบนเนอร์ 1"></button>
          <button type="button" data-bs-target="#fh-banner" data-bs-slide-to="1" aria-label="แบนเนอร์ 2"></button>
          <button type="button" data-bs-target="#fh-banner" data-bs-slide-to="2" aria-label="แบนเนอร์ 3"></button>
        </div>

        <!-- รูปภาพแบนเนอร์แต่ละสไลด์ -->
        <div class="carousel-inner rounded-3 overflow-hidden">
          <div class="carousel-item active">
            <img src="/images/pp2.webp" class="d-block w-100" alt="แบนเนอร์รับสมัครงาน Lotus's">
          </div>
          <div class="carousel-item">
            <img src="/images/pp3.webp" class="d-block w-100" alt="แบนเนอร์รับสมัครพนักงานขายทั่วประเทศ">
          </div>
          <div class="carousel-item">
            <img src="/images/pp4.webp" class="d-block w-100" alt="แบนเนอร์ Bangkok Bank Banking Careers Connect 2026">
          </div>
        </div>

        <!-- ปุ่มเลื่อนซ้าย/ขวา -->
        <button class="carousel-control-prev" type="button" data-bs-target="#fh-banner" data-bs-slide="prev" aria-label="ก่อนหน้า">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          <span class="visually-hidden">ก่อนหน้า</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#fh-banner" data-bs-slide="next" aria-label="ถัดไป">
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
          <span class="visually-hidden">ถัดไป</span>
        </button>

      </div>
    </div>
    <% } %>


    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- ส่วนที่ 3: รายการงาน (Job List)                           -->
    <!-- ══════════════════════════════════════════════════════════ -->

    <!-- หัวแถวแสดงจำนวนผลลัพธ์ -->
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div class="fh-result-count">
        <i class="bi bi-briefcase me-1"></i>
        พบ <strong><%= jobList.length %></strong> ตำแหน่งงานที่เปิดรับสมัคร
        <% if (currentSearch) { %>
          สำหรับ "<span class="text-primary fw-semibold"><%= currentSearch %></span>"
        <% } %>
      </div>
      <div class="fh-sort-label text-muted">เรียงตาม: ล่าสุด</div>
    </div>

    <!-- รายการการ์ดงาน -->
    <div id="job-cards-container" class="d-flex flex-column gap-3">

      <!-- กรณีไม่มีงานที่ตรงกับเงื่อนไข -->
      <% if (jobList.length === 0) { %>
        <div class="card fh-empty-state text-center py-5">
          <div class="card-body">
            <div class="fh-empty-icon mb-3">
              <i class="bi bi-search fs-1 text-muted"></i>
            </div>
            <h2 class="h5 fw-bold text-dark mb-1">ไม่พบตำแหน่งงานที่ตรงกับเงื่อนไข</h2>
            <p class="text-muted small mb-3">ลองเปลี่ยนคำค้นหา หรือเลือกดูหมวดหมู่อื่นๆ</p>
            <a href="/" class="btn fh-btn-clear-search">ล้างเงื่อนไขทั้งหมด</a>
          </div>
        </div>

      <!-- กรณีมีงาน: วนลูปแสดงทุกตำแหน่ง -->
      <% } else { %>
        <% jobList.forEach(function(job) { %>

          <!-- การ์ดงาน: คลิกทั้งใบเพื่อไปหน้ารายละเอียด -->
          <a href="/jobs/<%= job.id %>" class="card fh-job-card">
            <div class="card-body">
              <div class="row g-3 align-items-center">

                <!-- คอลัมน์ซ้าย: ข้อมูลงาน -->
                <div class="col">

                  <!-- หมวดหมู่ + วันที่ลงประกาศ -->
                  <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                    <span class="badge fh-badge-category"><%= job.category %></span>
                    <span class="fh-post-date">
                      <i class="bi bi-clock me-1"></i>
                      <%= new Date(job.created_at).toLocaleDateString('th-TH') %>
                    </span>
                  </div>

                  <!-- ชื่อตำแหน่งงาน -->
                  <h3 class="fh-job-title mb-1"><%= job.title %></h3>

                  <!-- ชื่อบริษัท + สถานที่ -->
                  <div class="fh-job-meta mb-2">
                    <span>
                      <i class="bi bi-building me-1"></i>
                      <strong><%= job.company_name %></strong>
                    </span>
                    <span class="fh-meta-sep">|</span>
                    <span>
                      <i class="bi bi-geo-alt-fill me-1"></i>
                      <%= job.location %>
                    </span>
                  </div>

                  <!-- คำอธิบายงานย่อ -->
                  <p class="fh-job-desc mb-0"><%= job.description %></p>

                </div>

                <!-- คอลัมน์ขวา: เงินเดือน -->
                <div class="col-auto text-end">
                  <div class="fh-salary"><%= Number(job.budget).toLocaleString() %> ฿</div>
                  <div class="fh-salary-sub">/ เดือน</div>
                </div>

              </div>
            </div>
          </a><!-- /.fh-job-card -->

        <% }); %>
      <% } %>

    </div><!-- /#job-cards-container -->

  </div><!-- /.container-xl -->
</main>

<%- include('../partials/footer') %>
