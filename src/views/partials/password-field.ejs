<div class="field">
  <label for="<%= fieldId %>">
    <%= label %> <em>*</em>
  </label>

  <div class="password-field">
    <svg
      class="password-lock"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <rect x="5" y="10" width="14" height="11" rx="2" />
      <path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3" />
    </svg>

    <input
      id="<%= fieldId %>"
      name="<%= fieldId %>"
      type="password"
      placeholder="<%= placeholder %>"
      required
      autocomplete="new-password"
      <%= typeof minLength !== 'undefined' && minLength
        ? `minlength="${minLength}"`
        : '' %>
    >

    <button
      type="button"
      class="toggle-password"
      aria-label="แสดงรหัสผ่าน"
      data-for="<%= fieldId %>"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          class="eye-open"
          d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"
        />
        <circle class="eye-open" cx="12" cy="12" r="3" />
        <path
          class="eye-closed"
          d="m3 3 18 18M10.6 10.6a2 2 0 0 0 2.8 2.8M9.9 5.1A11 11 0 0 1 12 5c6.4 0 10 7 10 7a17 17 0 0 1-3.1 4.1M6.6 6.6C3.7 8.3 2 12 2 12s3.6 7 10 7c1 0 1.9-.2 2.7-.5"
        />
      </svg>
    </button>
  </div>

  <% if (error) { %>
    <small class="field-error"><%= error %></small>
  <% } %>
</div>
